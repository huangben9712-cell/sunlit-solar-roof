---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('articles');
const publishedPosts = allPosts
  .filter((post) => post.data.priority === 'P0' || post.data.priority === 'P1')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Solar Roof Articles - Sunlit" description="Practical guides and insights for B2B buyers sourcing complete BIPV solar roof systems.">
  <section class="bg-soft-green py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl">
      <p class="sunlit-overline mb-5">Knowledge Base</p>
      <h1 class="sunlit-section-title text-4xl md:text-5xl lg:text-6xl text-charcoal mb-6">Articles & Guides</h1>
      <p class="text-lg text-slate leading-relaxed max-w-3xl mx-auto">Practical insights on solar roof systems, B2B sourcing, and project quotation.</p>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {publishedPosts.map((post) => (
          <a href={`/articles/${post.slug}/`} class="sunlit-card overflow-hidden block group">
            {post.data.cover ? (
              <img src={post.data.cover.src} alt={post.data.cover.alt} class="w-full aspect-[16/9] object-cover" loading="lazy" />
            ) : (
              <div class="w-full aspect-[16/9] bg-gradient-to-br from-deep-green/20 to-soft-green"></div>
            )}
            <div class="p-7">
              <p class="text-sm font-heading font-bold text-deep-green mb-3">{post.data.category}</p>
              <h2 class="text-xl font-heading font-bold text-charcoal mb-3 group-hover:text-deep-green transition-colors">{post.data.title}</h2>
              <p class="text-slate leading-relaxed mb-5">{post.data.description}</p>
              <span class="font-bold text-deep-green group-hover:text-amber transition-colors">Read Article</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
