---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getImageAlt } from '../../data/imageAltManifest';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [
  { key: 'System Fundamentals', label: 'Solar Roof System Basics', description: 'System scope, active elements, inactive coverage and product-selection fundamentals.' },
  { key: 'Technical & Installation', label: 'Technical & Installation', description: 'Installation, electrical systems and product specification.' },
  { key: 'Products & Case Studies', label: 'Products & Case Studies', description: 'Product deep dives and real project walkthroughs.' },
  { key: 'Importing & Sourcing', label: 'Importing & Sourcing', description: 'Supplier evaluation, importing and project logistics.' },
  { key: 'Market Insights & ROI', label: 'Market Insights & ROI', description: 'Commercial models, market context and ROI discussion.' },
];

const articleGroups = categories
  .map((category) => ({ ...category, articles: articles.filter((article) => article.data.category === category.key) }))
  .filter((category) => category.articles.length > 0);

const startHere = [
  {
    eyebrow: 'Explainer guide',
    title: 'What Is a Solar Roof?',
    description: 'The essential introduction to an integrated solar roof, its components and its role in a complete building envelope.',
    href: '/resources/knowledge-base/what-is-solar-roof/',
    image: '/images/projects/hangzhou-xianghu-arcadia-villa/sunlit-bipv-solar-roof-aerial-view-hangzhou-xianghu.webp',
  },
  {
    eyebrow: 'Comparison guide',
    title: 'Solar Roof vs Solar Panels',
    description: 'A practical comparison of BIPV and conventional panels across function, appearance, installation and project fit.',
    href: '/solar-roof-vs-solar-panels/',
    image: '/images/projects/xuzhou-luxury-villa-the-ultimate-bipv-vs-bapv-contrast/sunlit-bipv-vs-bapv-solar-roof-comparison.webp',
  },
];

const whatsappHref = `https://wa.me/8617729920083?text=${encodeURIComponent("Hi Sunlit, I have a solar roof project and would like help finding the relevant technical information.")}`;
---

<Layout
  title="Solar Roof Knowledge Base | Sunlit"
  description="A practical knowledge base for B2B buyers researching solar roof installation, sourcing, project cases and commercial evaluation."
>
  <section class="bg-charcoal py-16 md:py-20 text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-white/45 mb-4">Resource Centre / Knowledge Base</p>
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 items-end">
        <div>
          <h1 class="font-heading font-bold text-4xl md:text-5xl leading-tight mb-5">Research a solar roof before you specify one.</h1>
          <p class="text-lg leading-relaxed text-white/65 max-w-2xl">Guides and articles for B2B buyers evaluating product fit, installation, sourcing and commercial viability.</p>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="rounded-xl border border-white/10 bg-white/5 p-4"><p class="text-2xl font-heading font-bold">2</p><p class="mt-1 text-xs leading-relaxed text-white/50">Start Here guides</p></div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4"><p class="text-2xl font-heading font-bold">{articles.length}</p><p class="mt-1 text-xs leading-relaxed text-white/50">Library articles</p></div>
          <a href="/resources/downloads/" class="rounded-xl border border-white/10 bg-white/5 p-4 hover:bg-white/10 transition-colors"><p class="text-sm font-heading font-bold">Docs</p><p class="mt-1 text-xs leading-relaxed text-white/50">Project documents</p></a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-white border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
        <div>
          <p class="sunlit-overline mb-3">Start Here</p>
          <h2 class="sunlit-section-title text-3xl md:text-4xl text-charcoal">Begin with the two decisions every buyer makes.</h2>
        </div>
        <p class="text-sm text-slate max-w-sm">These two guides are intentionally kept above the article library.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {startHere.map((guide) => (
          <a href={guide.href} class="group grid grid-cols-[0.78fr_1.22fr] rounded-2xl overflow-hidden border border-border bg-white hover:border-deep-green/35 hover:shadow-md transition-all">
            <div class="overflow-hidden min-h-full bg-light-gray">
              <img src={guide.image} alt={getImageAlt(guide.image, guide.title)} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-5 md:p-6">
              <p class="text-xs font-heading font-bold uppercase tracking-widest text-deep-green mb-2">{guide.eyebrow}</p>
              <h3 class="font-heading font-bold text-xl text-charcoal leading-tight mb-3 group-hover:text-deep-green transition-colors">{guide.title}</h3>
              <p class="text-sm text-slate leading-relaxed mb-4">{guide.description}</p>
              <span class="text-sm font-heading font-bold text-deep-green group-hover:text-amber transition-colors">Read guide →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-light-gray">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
        <div>
          <p class="sunlit-overline mb-3">Article library</p>
          <h2 class="sunlit-section-title text-3xl md:text-4xl text-charcoal">Explore the detail when you need it.</h2>
          <p class="text-slate leading-relaxed mt-3 max-w-2xl">Every article follows the same reading path: cover image, clear subject, practical summary and one direct route into the full guide.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          {articleGroups.map((group) => (
            <a href={`#${group.key.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="rounded-full border border-border bg-white px-3 py-1.5 text-xs font-heading font-bold text-deep-green hover:border-deep-green/35 transition-colors">{group.label}</a>
          ))}
        </div>
      </div>

      <div class="space-y-16">
        {articleGroups.map((group) => (
          <section id={group.key.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-7">
              <div>
                <p class="text-xs font-heading font-bold uppercase tracking-widest text-deep-green mb-2">{group.articles.length} {group.articles.length === 1 ? 'article' : 'articles'}</p>
                <h3 class="font-heading font-bold text-2xl text-charcoal">{group.label}</h3>
                <p class="text-sm text-slate mt-1">{group.description}</p>
              </div>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {group.articles.map((article) => (
                <a href={`/articles/${article.slug}/`} class="group overflow-hidden rounded-2xl border border-border bg-white hover:-translate-y-0.5 hover:border-deep-green/35 hover:shadow-lg transition-all">
                  <div class="aspect-[16/10] bg-soft-green overflow-hidden">
                    <img
                      src={article.data.cover?.src || '/images/projects/pioneer-residential-retrofit/retrofitted-solar-roof-urban-villa.webp'}
                      alt={article.data.cover?.alt || article.data.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-6">
                    <p class="text-xs font-heading font-bold text-deep-green mb-3">{article.data.category}</p>
                    <h4 class="font-heading font-bold text-lg text-charcoal leading-snug mb-3 group-hover:text-deep-green transition-colors">{article.data.title}</h4>
                    <p class="text-sm text-slate leading-relaxed line-clamp-3 mb-5">{article.data.description}</p>
                    <span class="inline-flex items-center gap-1.5 text-sm font-heading font-bold text-deep-green group-hover:text-amber transition-colors">Read article <span aria-hidden="true">→</span></span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white border-t border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl rounded-3xl bg-soft-green px-7 py-10 md:px-12 md:py-12 grid lg:grid-cols-[1fr_auto] gap-8 items-center">
      <div>
        <p class="sunlit-overline mb-3">Apply it to a live project</p>
        <h2 class="font-heading font-bold text-3xl text-charcoal mb-3">Need help turning the research into a specification?</h2>
        <p class="text-slate leading-relaxed max-w-2xl">Tell us your country, roof area, building type and preferred system. We will point you to the right technical materials for your project stage.</p>
      </div>
      <a href={whatsappHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-full bg-deep-green px-6 py-3.5 font-heading font-bold text-white hover:bg-deep-green/90 transition-colors whitespace-nowrap">Discuss on WhatsApp <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
