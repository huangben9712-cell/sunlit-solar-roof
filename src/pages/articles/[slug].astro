---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getCollection('articles');
const relatedPosts = allPosts
  .filter((candidate) => candidate.data.category === post.data.category && candidate.slug !== post.slug)
  .slice(0, 3);
const tocItems = headings.filter((heading) => heading.depth === 2);
const formattedDate = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<Layout title={`${post.data.title} — Sunlit Solar Roof`} description={post.data.description}>
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-deep-green w-0 z-50 transition-none"></div>

  <div class="border-b border-gray-100 bg-white">
    <div class="max-w-[860px] mx-auto px-6 py-3 text-sm text-slate flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-deep-green transition-colors">Home</a>
      <span class="text-gray-300">/</span>
      <a href="/articles/" class="hover:text-deep-green transition-colors">Articles</a>
      <span class="text-gray-300">/</span>
      <span class="text-charcoal">{post.data.title}</span>
    </div>
  </div>

  <header class="bg-white pt-12 pb-0">
    <div class="max-w-[860px] mx-auto px-6">
      <div class="flex items-center gap-3 mb-5 text-sm text-slate">
        <span class="text-deep-green font-semibold">{post.data.category}</span>
        <span class="text-gray-300">·</span>
        <span>{formattedDate}</span>
        <span class="text-gray-300">·</span>
        <span>{readingTime} min read</span>
      </div>

      <h1 class="font-heading font-bold text-[2.6rem] md:text-[3.2rem] text-charcoal leading-[1.1] mb-6 tracking-tight">
        {post.data.title}
      </h1>

      {post.data.cover ? (
        <figure class="w-full aspect-[16/7] overflow-hidden bg-soft-green mt-8 rounded-2xl">
          <img src={post.data.cover.src} alt={post.data.cover.alt} class="w-full h-full object-cover" fetchpriority="high" />
        </figure>
      ) : (
        <div class="w-full aspect-[16/7] overflow-hidden bg-gradient-to-br from-deep-green to-[#1a3a2a] flex items-center justify-center mt-8 rounded-2xl">
          <p class="text-sm font-heading font-bold uppercase tracking-widest text-white/50">Sunlit Solar Roof</p>
        </div>
      )}
    </div>
  </header>

  <main class="bg-white py-14">
    <div class="max-w-[860px] mx-auto px-6">
      {tocItems.length >= 3 && (
        <nav class="mb-12 pb-10 border-b border-gray-100" aria-label="Article table of contents">
          <p class="text-sm text-slate mb-5">By the end of this article, you will have learned about:</p>
          <ol class="space-y-3">
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.slug}`} class="flex items-center gap-3 text-[16px] text-charcoal hover:text-deep-green transition-colors group">
                  <svg class="w-4 h-4 text-deep-green shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0-4 4m4-4H3" />
                  </svg>
                  <span>{item.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <article class="article-content">
        <Content />
      </article>

      <div class="mt-16 pt-8 border-t border-gray-100 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs text-slate/50 mb-1">Original WordPress source</p>
          <a href={post.data.legacyUrl} target="_blank" rel="noopener" class="text-sm text-deep-green hover:underline break-all">{post.data.legacyUrl}</a>
        </div>
        <a href="/articles/" class="sunlit-btn-secondary text-sm">← Back to Articles</a>
      </div>
    </div>
  </main>

  {relatedPosts.length > 0 && (
    <section class="py-16 bg-soft-green">
      <div class="max-w-[860px] mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-charcoal">More in {post.data.category}</h2>
          <a href="/articles/" class="text-sm text-deep-green font-heading font-bold hover:underline">View all →</a>
        </div>
        <div class="grid md:grid-cols-3 gap-5">
          {relatedPosts.map((related) => (
            <a href={`/articles/${related.slug}/`} class="sunlit-card overflow-hidden block group hover:shadow-md transition-shadow bg-white">
              {related.data.cover ? (
                <img src={related.data.cover.src} alt={related.data.cover.alt} class="w-full h-28 object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-28 bg-gradient-to-br from-deep-green/10 to-deep-green/5"></div>
              )}
              <div class="p-6">
                <p class="text-xs font-heading font-bold text-deep-green uppercase tracking-wide mb-2">{related.data.category}</p>
                <h3 class="font-heading font-bold text-charcoal group-hover:text-deep-green transition-colors leading-snug mb-2">{related.data.title}</h3>
                <p class="text-sm text-slate leading-relaxed line-clamp-2">{related.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16 dark-green-gradient text-white">
    <div class="max-w-[860px] mx-auto px-6 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-white/40 mb-4">Sunlit Solar Roof</p>
      <h2 class="font-heading font-bold text-3xl md:text-4xl mb-4 leading-tight">Ready to Move from Reading to a Real Project?</h2>
      <p class="text-white/70 text-lg mb-8 max-w-xl mx-auto">Share your roof area and location. We'll tell you which system fits and what to expect.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact/" class="sunlit-btn-amber">Get a Free Consultation →</a>
        <a href="/system-overview/" class="sunlit-btn-outline-white">Explore Supply Scope</a>
      </div>
    </div>
  </section>

  <script is:inline>
    const bar = document.getElementById('reading-progress');
    if (bar) {
      window.addEventListener('scroll', () => {
        const doc = document.documentElement;
        const total = doc.scrollHeight - doc.clientHeight;
        bar.style.width = total > 0 ? (doc.scrollTop / total * 100) + '%' : '0%';
      }, { passive: true });
    }
  </script>
</Layout>

<style>
  .article-content :global(h2) { font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif); font-size: clamp(2rem, 4vw, 2.5rem); font-weight: 700; line-height: 1.18; letter-spacing: -0.03em; color: #17232b; margin: 4rem 0 1.25rem; scroll-margin-top: 6rem; }
  .article-content :global(h3) { font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif); font-size: 1.25rem; font-weight: 700; line-height: 1.35; color: #17232b; margin: 2rem 0 0.75rem; }
  .article-content :global(h4) { font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif); font-size: 1rem; font-weight: 700; line-height: 1.4; color: #17232b; margin: 1.5rem 0 0.5rem; }
  .article-content :global(p) { color: #333; font-size: 1.0625rem; line-height: 1.85; margin: 1.25rem 0; }
  .article-content :global(p:first-child) { color: #17232b; font-size: clamp(1.2rem, 2.5vw, 1.35rem); font-weight: 700; line-height: 1.65; margin-top: 0; margin-bottom: 2.5rem; }
  .article-content :global(ul), .article-content :global(ol) { color: #333; font-size: 1.0625rem; line-height: 1.75; margin: 1.25rem 0; padding-left: 1.4rem; }
  .article-content :global(li) { margin: 0.55rem 0; }
  .article-content :global(blockquote) { border-left: 3px solid #0f4d3a; color: #17232b; font-size: 1.1rem; font-style: italic; font-weight: 500; line-height: 1.7; margin: 2.5rem 0; padding-left: 1.5rem; }
  .article-content :global(a) { color: #0f4d3a; font-weight: 600; text-decoration: underline; text-decoration-color: rgba(15, 77, 58, 0.35); text-underline-offset: 0.18em; }
  .article-content :global(img) { width: 100%; height: auto; display: block; border-radius: 1rem; margin: 2.25rem 0; background: #edf6f1; }
  .article-content :global(hr) { border-color: #edf0ee; margin: 3rem 0; }
</style>
