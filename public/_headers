# Cloudflare Pages response headers.
# Ignored by Apache/Cloudways (that host uses public/.htaccess instead).
# Cloudflare Pages only understands prefix globs, so keep the rules simple.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted build assets never change between deployments.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media is replaced rarely; a month is enough and keeps the edge cache warm.
/images/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

# HTML must revalidate so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
