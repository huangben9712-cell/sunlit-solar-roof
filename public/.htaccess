# Sunlit static Astro release: Apache/Cloudways migration rules.
# This file is inert until the staged static directory becomes public_html.
# Use explicit production HTTPS targets below: relative R=301 substitutions can become HTTP locations behind a TLS-terminating proxy, creating an avoidable second hop.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy system, product line, company and hub URLs.
  RewriteRule ^supply-scope/?$ https://www.sunlitsolarroof.com/system-overview/ [R=301,L,NE]
  RewriteRule ^solar-roofs/?$ https://www.sunlitsolarroof.com/system-overview/ [R=301,L,NE]
  RewriteRule ^invisible-solar-roof/?$ https://www.sunlitsolarroof.com/system-overview/ [R=301,L,NE]
  RewriteRule ^lumina-slate-series/?$ https://www.sunlitsolarroof.com/lumina-slate/ [R=301,L,NE]
  RewriteRule ^storm-guard-series/?$ https://www.sunlitsolarroof.com/storm-guard/ [R=301,L,NE]
  RewriteRule ^contact-us/?$ https://www.sunlitsolarroof.com/contact/ [R=301,L,NE]
  RewriteRule ^about-us/?$ https://www.sunlitsolarroof.com/about/ [R=301,L,NE]
  RewriteRule ^knowledges/?$ https://www.sunlitsolarroof.com/articles/ [R=301,L,NE]
  RewriteRule ^project/?$ https://www.sunlitsolarroof.com/projects/ [R=301,L,NE]

  # Legacy WordPress articles and previous Astro article route.
  RewriteRule ^sunlit-bipv-story/?$ https://www.sunlitsolarroof.com/articles/sunlit-bipv-story/ [R=301,L,NE]
  RewriteRule ^import-solar-roof/?$ https://www.sunlitsolarroof.com/articles/import-solar-roof/ [R=301,L,NE]
  RewriteRule ^solar-roof-electrical-system/?$ https://www.sunlitsolarroof.com/articles/solar-roof-electrical-system/ [R=301,L,NE]
  RewriteRule ^solar-roof-case-study/?$ https://www.sunlitsolarroof.com/articles/solar-roof-case-study/ [R=301,L,NE]
  RewriteRule ^what-is-a-solar-roof/?$ https://www.sunlitsolarroof.com/resources/knowledge-base/what-is-solar-roof/ [R=301,L,NE]
  RewriteRule ^articles/what-is-a-solar-roof/?$ https://www.sunlitsolarroof.com/resources/knowledge-base/what-is-solar-roof/ [R=301,L,NE]
  RewriteRule ^why-are-most-solar-roofs-black/?$ https://www.sunlitsolarroof.com/articles/why-are-most-solar-roofs-black/ [R=301,L,NE]
  RewriteRule ^solar-roof-roi-for-developers/?$ https://www.sunlitsolarroof.com/articles/solar-roof-roi-for-developers/ [R=301,L,NE]
  RewriteRule ^solar-roofing-business-model/?$ https://www.sunlitsolarroof.com/articles/solar-roofing-business-model/ [R=301,L,NE]
  RewriteRule ^storm-guard-story/?$ https://www.sunlitsolarroof.com/articles/storm-guard-story/ [R=301,L,NE]
  RewriteRule ^solar-system-categories/?$ https://www.sunlitsolarroof.com/articles/solar-system-categories/ [R=301,L,NE]
  RewriteRule ^future-of-solar-roofs/?$ https://www.sunlitsolarroof.com/articles/future-of-solar-roofs/ [R=301,L,NE]
  RewriteRule ^offshore-bipv-guide/?$ https://www.sunlitsolarroof.com/articles/offshore-bipv-guide/ [R=301,L,NE]
  RewriteRule ^lumina-slate-story/?$ https://www.sunlitsolarroof.com/articles/lumina-slate-story/ [R=301,L,NE]
  RewriteRule ^how-to-install-solar-roof/?$ https://www.sunlitsolarroof.com/articles/how-to-install-solar-roof/ [R=301,L,NE]

  # Legacy detail pages resolve to the matching live product section.
  RewriteRule ^lumina-slate-series/lumina-slate-series-roof-base-layer-installation/?$ https://www.sunlitsolarroof.com/lumina-slate/#installation-evidence [R=301,L,NE]
  RewriteRule ^lumina-slate-series/lumina-slate-series-electrical-system/?$ https://www.sunlitsolarroof.com/lumina-slate/#component-library [R=301,L,NE]
  RewriteRule ^lumina-slate-series/lumina-slate-series-ridge-edge-tiles/?$ https://www.sunlitsolarroof.com/lumina-slate/#component-library [R=301,L,NE]
  RewriteRule ^lumina-slate-series/lumina-slate-series-main-roofing-tiles-installation/?$ https://www.sunlitsolarroof.com/lumina-slate/#installation-evidence [R=301,L,NE]
  RewriteRule ^storm-guard-series/storm-guard-series-roofing-tiles/?$ https://www.sunlitsolarroof.com/storm-guard/#component-library [R=301,L,NE]
  RewriteRule ^storm-guard-series/storm-guard-series-roof-base-layer/?$ https://www.sunlitsolarroof.com/storm-guard/#installation-evidence [R=301,L,NE]
  RewriteRule ^storm-guard-series/storm-guard-series-electrical-system/?$ https://www.sunlitsolarroof.com/storm-guard/#component-library [R=301,L,NE]
  RewriteRule ^storm-guard-series/storm-guard-series-ridge-edge-tiles/?$ https://www.sunlitsolarroof.com/storm-guard/#component-library [R=301,L,NE]

  # Retired WPML landing pages have an English canonical destination until maintained translations exist.
  RewriteRule ^(?:osynligt-solcellstak-for-premiumprojekt|tetto-solare-invisibile-per-gli-edifici-di-pregio|techo-solar-invisible-para-promociones-premium|telhado-solar-invisivel-para-empreendimentos-de-luxo|onzichtbaar-zonnedak-voor-hoogwaardige-projecten|unsichtbares-solardach-fuer-premium-entwicklungen)/?$ https://www.sunlitsolarroof.com/system-overview/ [R=301,L,NE]

  # Old WordPress taxonomy and author archive paths.
  RewriteRule ^category/(?:sourcing-guide|market-insights|case-studies|technical-installation)/?$ https://www.sunlitsolarroof.com/articles/ [R=301,L,NE]
  RewriteRule ^author/huangben/?$ https://www.sunlitsolarroof.com/about/ [R=301,L,NE]

  # Preserve direct links to the historical WordPress brochures.
  RewriteRule ^wp-content/uploads/2026/05/sunlit-lumina-slate-bipv-solar-roof-brochure-2026\.pdf$ https://www.sunlitsolarroof.com/downloads/lumina-slate-bipv-solar-roof-brochure-2026.pdf [R=301,L,NE]
  RewriteRule ^wp-content/uploads/2026/05/sunlit-storm-guard-bipv-solar-roof-brochure-2026\.pdf$ https://www.sunlitsolarroof.com/downloads/storm-guard-bipv-solar-roof-brochure-2026.pdf [R=301,L,NE]

  # Search Console retains these submitted WordPress sitemap paths; consolidate them to the current Astro sitemap.
  RewriteRule ^(?:sitemap_index|project-sitemap|post-sitemap|page-sitemap)\.xml$ https://www.sunlitsolarroof.com/sitemap.xml [R=301,L,NE]
</IfModule>
